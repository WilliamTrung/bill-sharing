# PostgreSQL credentials (used by the db service and to build DATABASE_URL)
POSTGRES_USER=bills
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bills

# Admin sign-in password (minimum 8 characters)
ADMIN_PASSWORD=change-me-admin-password

# Session signing secret (minimum 16 characters)
SESSION_SECRET=change-me-at-least-16-characters-long

# Host port the app is published on
APP_PORT=8080

# Set to false only when running plain HTTP locally (no TLS in front)
COOKIE_SECURE=true

# Per-bill upload limit in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400

# Currency symbol shown in the UI
CURRENCY=$
