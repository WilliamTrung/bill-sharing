# Postgres (MSI: shared-postgres on db-net; local: your own Postgres URL)
DATABASE_URL=postgres://bills:change-me-strong-password@localhost:5432/bills?sslmode=disable

# Seeded account (created on startup if missing; username defaults to the email's local part)
SEED_USERNAME=admin
SEED_EMAIL=admin@example.com
SEED_PASSWORD=change-me-seed-password

# Session signing secret (minimum 16 characters)
SESSION_SECRET=change-me-at-least-16-characters-long

# Host port the app is published on
APP_HOST_PORT=8080

# Set to false only when running plain HTTP locally (no TLS in front)
COOKIE_SECURE=true

# Per-bill upload limit in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400

# Currency symbol shown in the UI
CURRENCY=$

# Optional Gmail SMTP (Google app password) — sends welcome mail when a member with email is added
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your@gmail.com