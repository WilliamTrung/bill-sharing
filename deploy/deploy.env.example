# Copy to MSI: dev/shared/bill-sharing/secrets/deploy.env — never commit real values.

DATABASE_URL=postgres://bills:REPLACE@shared-postgres:5432/bills?sslmode=disable

SEED_USERNAME=REPLACE_SEED_USERNAME
SEED_EMAIL=REPLACE_SEED_EMAIL
SEED_PASSWORD=REPLACE_SEED_PASSWORD_MIN_8
SESSION_SECRET=REPLACE_SESSION_SECRET_MIN_16_CHARS

APP_HOST_PORT=8080
COOKIE_SECURE=true
MAX_UPLOAD_BYTES=26214400
CURRENCY=VND
# 0 for VND (no subunits), 2 for $/€
CURRENCY_DECIMALS=0

# Optional Gmail SMTP (app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Share da Bill

# Public origin used to build invitation links (no trailing slash)
PUBLIC_BASE_URL=http://bill-sharing.williamthanhtrung.id.vn

# Emails allowed to edit members/groups and resend invitations.
# JSON array or comma-separated. The seed email is always an admin too.
ADMIN_EMAILS=["williamthanhtrungq2@gmail.com"]

DEPLOY_ENV_FILE=/home/tuf/dev/shared/bill-sharing/secrets/deploy.env
